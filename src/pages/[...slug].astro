---
import { render } from "astro:content"
import Backlinks from "../components/Backlinks.astro"
import PostFeed from "../components/PostFeed.astro"
import Base from "../layouts/Base.astro"
import { getBacklinks } from "../lib/backlinks"
import { formatDate, getPosts } from "../lib/posts"
import { tagSlug } from "../lib/tags"

export async function getStaticPaths() {
  const posts = await getPosts()
  const backlinks = await getBacklinks(posts)
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, backlinks: backlinks.get(post.id) ?? [], recent: posts.slice(0, 5) },
  }))
}

const { post, backlinks, recent } = Astro.props
const { Content, remarkPluginFrontmatter } = await render(post)
---

<Base
  title={post.data.title}
  description={post.data.description}
  crumb={post.data.title}
  image={`/og/${post.id}.png`}
>
  <article>
    <h1 class="article-title">{post.data.title}</h1>
    <ul class="tags">
      {
        post.data.tags.map((tag) => (
          <li>
            <a href={`/tags/${tagSlug(tag)}`}>{tagSlug(tag)}</a>
          </li>
        ))
      }
    </ul>
    <p class="content-meta">
      <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>, {
        remarkPluginFrontmatter.minutesRead
      } min read
    </p>
    <div class="prose">
      <Content />
    </div>
  </article>
  <hr class="footer-divider" />
  <PostFeed posts={recent} current={post.id} compact />
  <Backlinks posts={backlinks} />
</Base>
