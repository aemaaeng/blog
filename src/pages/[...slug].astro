---
import { render } from "astro:content"
import Backlinks from "../components/Backlinks.astro"
import RecentPosts from "../components/RecentPosts.astro"
import Base from "../layouts/Base.astro"
import { getBacklinks } from "../lib/backlinks"
import { formatDate, getPosts } from "../lib/posts"
import { tagSlug } from "../lib/tags"

export async function getStaticPaths() {
  const posts = await getPosts()
  const backlinks = await getBacklinks(posts)
  return posts.map((post) => ({
    params: { slug: post.id },
    props: { post, backlinks: backlinks.get(post.id) ?? [] },
  }))
}

const { post, backlinks } = Astro.props
const { Content } = await render(post)
---

<Base title={post.data.title} description={post.data.description}>
  <article>
    <h1>{post.data.title}</h1>
    <ul class="tags">
      {
        post.data.tags.map((tag) => (
          <li>
            <a href={`/tags/${tagSlug(tag)}`}>{tagSlug(tag)}</a>
          </li>
        ))
      }
    </ul>
    <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
    <Content />
  </article>
  <Backlinks posts={backlinks} />
  <RecentPosts current={post.id} />
</Base>
