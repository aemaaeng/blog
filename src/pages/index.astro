---
import { getEntry, render } from "astro:content"
import PostFeed from "../components/PostFeed.astro"
import Base from "../layouts/Base.astro"
import { getPosts } from "../lib/posts"

const intro = await getEntry("home", "index")
if (!intro) throw new Error("content/index.md가 없습니다")
const { Content } = await render(intro)
const posts = await getPosts()
---

<Base title={intro.data.title} description={intro.data.description}>
  <div class="prose intro">
    <Content />
  </div>
  <hr />
  <PostFeed posts={posts} />
</Base>

<style>
  .intro {
    margin-top: 1rem;
  }
  hr {
    height: 1px;
    margin: 2rem 0;
    border: none;
    background: var(--divider);
  }
</style>
