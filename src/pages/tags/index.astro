---
import Base from "../../layouts/Base.astro"
import { getPosts } from "../../lib/posts"
import { groupByTag } from "../../lib/tags"

// 태그마다 글 카드를 반복하면 산만해서 "태그 이름 + 글 수" 칩으로 보여준다
const groups = groupByTag(await getPosts())
---

<Base title="태그 목록" crumb="태그 목록">
  <h1 class="article-title">태그 목록</h1>
  <p class="count">총 {groups.size}개의 태그를 찾았습니다.</p>
  <ul class="chips">
    {
      [...groups].map(([tag, posts]) => (
        <li>
          <a href={`/tags/${tag}`}>
            <span class="name">{tag}</span>
            <span class="num">{posts.length}</span>
          </a>
        </li>
      ))
    }
  </ul>
</Base>

<style>
  .count {
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
    color: var(--gray);
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chips a {
    display: inline-flex;
    align-items: baseline;
    gap: 7px;
    padding: 7px 14px;
    border: 1px solid var(--divider);
    border-radius: 999px;
    color: var(--tag);
    transition:
      border-color 0.15s ease,
      background-color 0.15s ease;
  }
  .chips a:hover {
    border-color: var(--accent);
    background: color-mix(in srgb, var(--accent) 5%, transparent);
  }
  .name {
    font-size: 0.95rem;
    font-weight: 600;
  }
  .num {
    font-size: 0.8rem;
    color: var(--gray);
  }
</style>
