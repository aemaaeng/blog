---
import type { CollectionEntry } from "astro:content"
import { formatDate } from "../lib/posts"
import { tagSlug } from "../lib/tags"

// 태그 페이지용 목록: 날짜, 제목, 태그
interface Props {
  posts: CollectionEntry<"posts">[]
}
const { posts } = Astro.props
---

<p class="count">{posts.length}건의 항목</p>
<ul class="post-list">
  {
    posts.map((post) => (
      <li>
        <time datetime={post.data.date.toISOString()}>{formatDate(post.data.date)}</time>
        <h3>
          <a href={`/${post.id}`}>{post.data.title}</a>
        </h3>
        <ul class="tags">
          {post.data.tags.map((tag) => (
            <li>
              <a href={`/tags/${tagSlug(tag)}`}>{tagSlug(tag)}</a>
            </li>
          ))}
        </ul>
      </li>
    ))
  }
</ul>

<style>
  .count {
    margin: 0 0 1.5rem;
    font-size: 0.85rem;
    color: var(--gray);
  }
  .post-list {
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .post-list > li + li {
    margin-top: 1.25rem;
  }
  time {
    display: block;
    margin-bottom: 2px;
    font-size: 0.8rem;
    color: var(--text-meta);
  }
  h3 {
    margin: 0;
    font-size: 1.1rem;
    font-weight: 600;
  }
  h3 a {
    color: var(--text);
  }
  h3 a:hover {
    color: var(--accent);
  }
  .tags {
    margin-top: 6px;
  }
</style>
